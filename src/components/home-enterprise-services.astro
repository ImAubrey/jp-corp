---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import networkOperationsCenter from "../assets/home/network-operations-center.webp";
import rackDeployment from "../assets/home/rack-deployment.webp";
import serverHall from "../assets/data-centers/server-hall.webp";

export interface Props {
  locale: string;
  t: (key: string) => string;
}

const { locale, t } = Astro.props;

function createLocalePath(path: string) {
  if (locale === "en") return path;
  return `/${locale}${path}`;
}

interface ProviderNode {
  name: string;
  role: string;
  className: string;
  logo?: string;
  icon?: string;
  mark?: string;
  x: number;
  y: number;
  line?: string;
  hub?: boolean;
}

const providers: ProviderNode[] = [
  {
    name: "OursZone",
    role: "NETWORK CORE",
    className: "provider--ourszone",
    mark: "OZ",
    x: 50,
    y: 50,
    hub: true,
  },
  {
    name: "Cogent",
    role: "TRANSIT",
    className: "provider--cogent",
    logo: "https://www.cogentco.com/files/images/c2020/cogentco_logo.png",
    x: 13,
    y: 14,
    line: "M450 228 L117 68",
  },
  {
    name: "NTT",
    role: "TRANSIT",
    className: "provider--ntt",
    logo: "https://group.ntt/common/img/logo_site_a.svg",
    x: 37,
    y: 10,
    line: "M450 228 L333 48",
  },
  {
    name: "Equinix IX",
    role: "EXCHANGE",
    className: "provider--equinix",
    icon: "simple-icons:equinixmetal",
    x: 63,
    y: 13,
    line: "M450 228 L567 62",
  },
  {
    name: "JPNAP",
    role: "EXCHANGE",
    className: "provider--jpnap",
    logo: "https://www.jpnap.net/img/common/logo.svg",
    x: 87,
    y: 11,
    line: "M450 228 L783 52",
  },
  {
    name: "Hytron",
    role: "AS17433",
    className: "provider--hytron",
    logo: "https://www.hytron.io/images/logo.png",
    x: 13,
    y: 84,
    line: "M450 228 L117 386",
  },
  {
    name: "SoftBank",
    role: "PEERING",
    className: "provider--softbank",
    logo: "https://www.softbank.jp/site/set/common/sunshine/shared/img/logo-sb.svg",
    x: 37,
    y: 87,
    line: "M450 228 L333 400",
  },
  {
    name: "IIJ",
    role: "PEERING",
    className: "provider--iij",
    logo: "https://www.iij.ad.jp/en/common/images/hd_logo01.png",
    x: 63,
    y: 87,
    line: "M450 228 L567 400",
  },
  {
    name: "Lumen",
    role: "TRANSIT",
    className: "provider--lumen",
    icon: "simple-icons:lumen",
    x: 87,
    y: 84,
    line: "M450 228 L783 386",
  },
];

const services = [
  {
    nameKey: "home.enterprise.services.transit.name",
    index: "01",
  },
  {
    nameKey: "home.enterprise.services.hosting.name",
    index: "02",
  },
  {
    nameKey: "home.enterprise.services.maintenance.name",
    index: "03",
  },
];
---

<section
  class="enterprise-story mt-24"
  data-enterprise-services
  data-motion="none"
  aria-labelledby="enterprise-story-title"
>
  <div class="enterprise-story__scene" data-enterprise-services-pin>
  <div class="enterprise-story__intro">
    <div>
      <p class="enterprise-story__kicker">{t("home.enterprise.services.kicker")}</p>
      <h2
        id="enterprise-story-title"
        class="mt-3 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 md:text-5xl lg:text-6xl"
      >
        {t("home.enterprise.services.title")}
      </h2>
    </div>
    <div class="enterprise-story__intro-copy">
      <p>{t("home.enterprise.services.subtitle")}</p>
      <span class="enterprise-story__scroll-hint">
        <i aria-hidden="true"></i>
        {t("home.enterprise.services.scrollHint")}
      </span>
    </div>
  </div>

  <div class="enterprise-story__pin">
    <div class="enterprise-story__rail" aria-label={t("home.enterprise.services.title")}>
      <div class="enterprise-story__progress" aria-hidden="true">
        <span data-enterprise-progress></span>
      </div>
      {
        services.map((service, index) => (
          <div
            class="enterprise-story__rail-item"
            data-enterprise-step
            data-active={index === 0 ? "true" : "false"}
          >
            <span>{service.index}</span>
            <strong>{t(service.nameKey)}</strong>
          </div>
        ))
      }
    </div>

    <div class="enterprise-story__viewport">
      <article
        class="enterprise-story__panel enterprise-story__panel--transit"
        data-enterprise-panel
        data-service="transit"
      >
        <div class="enterprise-story__copy" data-enterprise-panel-copy>
          <div class="enterprise-story__number">01</div>
          <p class="enterprise-story__eyebrow">
            {t("home.enterprise.services.transit.eyebrow")}
          </p>
          <h3>{t("home.enterprise.services.transit.name")}</h3>
          <p class="enterprise-story__description">
            {t("home.enterprise.services.transit.description")}
          </p>
          <div class="enterprise-story__meta">
            <span>{t("home.enterprise.services.transit.price")}</span>
            <a href={createLocalePath("/ip-transit/")}>
              {t("home.enterprise.services.learnMore")}
              <Icon name="bx:bx-right-arrow-alt" />
            </a>
          </div>
        </div>

        <div
          class="enterprise-story__visual enterprise-story__network"
          data-enterprise-panel-visual
          aria-label={t("home.enterprise.services.networkLabel")}
        >
          <div class="enterprise-story__visual-head">
            <span>
              <i></i>
              {t("home.enterprise.services.networkLabel")}
            </span>
            <strong>8 PATHS · BGP</strong>
          </div>

          <div class="enterprise-story__network-map">
            <div class="enterprise-story__network-grid" aria-hidden="true"></div>
            <svg
              class="enterprise-story__links"
              viewBox="0 0 900 455"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              {
                providers.filter((provider) => provider.line).map((provider) => (
                  <path d={provider.line} data-enterprise-link></path>
                ))
              }
            </svg>

            {
              providers.map((provider, index) => (
                <div
                  class:list={[
                    "enterprise-story__provider",
                    provider.className,
                    { "enterprise-story__provider--hub": provider.hub },
                  ]}
                  style={`--provider-x:${provider.x}%;--provider-y:${provider.y}%`}
                  data-enterprise-provider
                  data-provider-order={index + 1}
                >
                  <div class="enterprise-story__provider-logo">
                    {provider.logo ? (
                      <img src={provider.logo} alt="" loading="lazy" />
                    ) : provider.icon ? (
                      <Icon name={provider.icon} aria-hidden="true" />
                    ) : (
                      <span class="enterprise-story__provider-monogram" aria-hidden="true">
                        {provider.mark}
                      </span>
                    )}
                  </div>
                  <span>{provider.name}</span>
                  <small>{provider.role}</small>
                </div>
              ))
            }
          </div>

          <div class="enterprise-story__visual-foot">
            <span>TY8 / TY1</span>
            <span>RPKI VALIDATED</span>
            <span>LIVE ROUTES</span>
          </div>
        </div>
      </article>

      <article
        class="enterprise-story__panel enterprise-story__panel--hosting"
        data-enterprise-panel
        data-service="hosting"
      >
        <div class="enterprise-story__copy" data-enterprise-panel-copy>
          <div class="enterprise-story__number">02</div>
          <p class="enterprise-story__eyebrow">
            {t("home.enterprise.services.hosting.eyebrow")}
          </p>
          <h3>{t("home.enterprise.services.hosting.name")}</h3>
          <p class="enterprise-story__description">
            {t("home.enterprise.services.hosting.description")}
          </p>
          <div class="enterprise-story__meta">
            <span>{t("home.enterprise.services.hosting.price")}</span>
            <a href={createLocalePath("/hosting/")}>
              {t("home.enterprise.services.learnMore")}
              <Icon name="bx:bx-right-arrow-alt" />
            </a>
          </div>
        </div>

        <figure
          class="enterprise-story__visual enterprise-story__photo"
          data-enterprise-panel-visual
        >
          <Image
            src={serverHall}
            alt={t("home.enterprise.services.hosting.visualAlt")}
            width={1000}
            loading="lazy"
          />
          <div class="enterprise-story__photo-shade"></div>
          <div class="enterprise-story__photo-status">
            <span><i></i>{t("home.enterprise.services.hosting.visualStatus")}</span>
            <strong>TY8 · TOKYO</strong>
          </div>
          <figcaption>
            <div>
              <small>{t("home.enterprise.services.hosting.rackLabel")}</small>
              <strong>42U</strong>
            </div>
            <div>
              <small>{t("home.enterprise.services.hosting.powerLabel")}</small>
              <strong>A+B</strong>
            </div>
            <div>
              <small>{t("home.enterprise.services.hosting.uplinkLabel")}</small>
              <strong>100G</strong>
            </div>
          </figcaption>
        </figure>
      </article>

      <article
        class="enterprise-story__panel enterprise-story__panel--maintenance"
        data-enterprise-panel
        data-service="maintenance"
      >
        <div class="enterprise-story__copy" data-enterprise-panel-copy>
          <div class="enterprise-story__number">03</div>
          <p class="enterprise-story__eyebrow">
            {t("home.enterprise.services.maintenance.eyebrow")}
          </p>
          <h3>{t("home.enterprise.services.maintenance.name")}</h3>
          <p class="enterprise-story__description">
            {t("home.enterprise.services.maintenance.description")}
          </p>
          <div class="enterprise-story__meta">
            <span>{t("home.enterprise.services.maintenance.price")}</span>
            <a href={createLocalePath("/contact/")}>
              {t("home.enterprise.services.learnMore")}
              <Icon name="bx:bx-right-arrow-alt" />
            </a>
          </div>
        </div>

        <div
          class="enterprise-story__visual enterprise-story__ops"
          data-enterprise-panel-visual
        >
          <div class="enterprise-story__ops-main">
            <Image
              src={networkOperationsCenter}
              alt={t("home.enterprise.services.maintenance.visualAlt")}
              width={1000}
              loading="lazy"
            />
            <div class="enterprise-story__photo-shade"></div>
            <div class="enterprise-story__ops-badge">
              <i></i>
              NOC · 24/7
            </div>
          </div>
          <div class="enterprise-story__ops-detail">
            <Image
              src={rackDeployment}
              alt=""
              width={500}
              loading="lazy"
            />
            <div>
              <span>{t("home.enterprise.services.maintenance.responseLabel")}</span>
              <strong>&lt; 15 MIN</strong>
              <small>{t("home.enterprise.services.maintenance.responseDetail")}</small>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
  </div>
</section>

<style>
  .enterprise-story {
    position: relative;
  }

  .enterprise-story__scene {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .enterprise-story__intro {
    position: relative;
    z-index: 4;
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .enterprise-story__kicker,
  .enterprise-story__eyebrow {
    color: #2563eb;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .enterprise-story__intro-copy {
    max-width: 31rem;
    color: #64748b;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .enterprise-story__scroll-hint {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin-top: 1.2rem;
    color: #334155;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .enterprise-story__scroll-hint i {
    position: relative;
    width: 1.35rem;
    height: 2rem;
    border: 1px solid rgba(51, 65, 85, 0.34);
    border-radius: 999px;
  }

  .enterprise-story__scroll-hint i::after {
    position: absolute;
    top: 0.4rem;
    left: 50%;
    width: 0.22rem;
    height: 0.38rem;
    border-radius: 999px;
    background: #2563eb;
    content: "";
    transform: translateX(-50%);
  }

  .enterprise-story__pin {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 1.5rem;
    min-height: min(76vh, 49rem);
  }

  .enterprise-story__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding-left: 2rem;
  }

  .enterprise-story__progress {
    position: absolute;
    top: 13%;
    bottom: 13%;
    left: 0.1rem;
    width: 1px;
    overflow: hidden;
    background: rgba(148, 163, 184, 0.38);
  }

  .enterprise-story__progress span {
    position: absolute;
    inset: 0;
    display: block;
    background: linear-gradient(180deg, #2563eb, #06b6d4, #10b981);
    box-shadow: 0 0 16px rgba(37, 99, 235, 0.36);
    transform: scaleY(0);
    transform-origin: top center;
  }

  .enterprise-story__rail-item {
    display: grid;
    gap: 0.3rem;
    opacity: 0.38;
    transition: opacity 0.25s ease;
  }

  .enterprise-story__rail-item[data-active="true"] {
    opacity: 1;
  }

  .enterprise-story__rail-item > span {
    color: #2563eb;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
  }

  .enterprise-story__rail-item strong {
    color: #0f172a;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .enterprise-story__viewport {
    position: relative;
    min-width: 0;
    min-height: min(76vh, 49rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 0 0, rgba(59, 130, 246, 0.12), transparent 36%),
      rgba(248, 250, 252, 0.8);
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.13);
    backdrop-filter: blur(24px) saturate(150%);
  }

  .enterprise-story__panel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.45fr);
    gap: clamp(1.2rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 3.25rem);
  }

  .enterprise-story__panel--maintenance {
    grid-template-columns: minmax(19rem, 0.84fr) minmax(0, 1.45fr);
  }

  .enterprise-story__panel:not(:first-child) {
    visibility: hidden;
    opacity: 0;
  }

  .enterprise-story__copy {
    position: relative;
    z-index: 4;
    isolation: isolate;
  }

  .enterprise-story__number {
    margin-bottom: 1.5rem;
    color: rgba(37, 99, 235, 0.13);
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(4.5rem, 8vw, 7.5rem);
    font-weight: 750;
    line-height: 0.7;
    letter-spacing: -0.08em;
  }

  .enterprise-story__copy h3 {
    max-width: 11ch;
    margin-top: 0.75rem;
    color: #0f172a;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(2.35rem, 4vw, 4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .enterprise-story__panel--maintenance .enterprise-story__copy h3 {
    max-width: 100%;
    font-size: clamp(1.95rem, 3.1vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .enterprise-story__description {
    max-width: 31rem;
    margin-top: 1.3rem;
    color: #64748b;
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .enterprise-story__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.25rem;
    align-items: center;
    margin-top: 1.7rem;
  }

  .enterprise-story__meta > span {
    color: #0f172a;
    font-size: 0.92rem;
    font-weight: 750;
  }

  .enterprise-story__meta a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.68rem 0.95rem;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    color: #0f172a;
    font-size: 0.78rem;
    font-weight: 750;
  }

  .enterprise-story__meta a :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .enterprise-story__visual {
    position: relative;
    z-index: 1;
    min-width: 0;
    height: clamp(28rem, 52vw, 39rem);
    max-height: calc(min(76vh, 49rem) - clamp(2.5rem, 6vw, 6.5rem));
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.09);
    border-radius: 1.5rem;
    background: #eef2f7;
    box-shadow: 0 22px 55px rgba(15, 23, 42, 0.13);
  }

  .enterprise-story__network {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background:
      radial-gradient(circle at 50% 50%, rgba(37, 99, 235, 0.15), transparent 31%),
      linear-gradient(145deg, #f8fafc 0%, #edf3f9 100%);
  }

  .enterprise-story__visual-head,
  .enterprise-story__visual-foot {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
    color: #64748b;
    font-size: 0.61rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .enterprise-story__visual-head span {
    display: inline-flex;
    gap: 0.48rem;
    align-items: center;
  }

  .enterprise-story__visual-head i,
  .enterprise-story__photo-status i,
  .enterprise-story__ops-badge i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.13);
  }

  .enterprise-story__visual-foot {
    border-top: 1px solid rgba(148, 163, 184, 0.2);
    border-bottom: 0;
    color: #475569;
    letter-spacing: 0.08em;
  }

  .enterprise-story__network-map {
    position: relative;
    min-height: 0;
  }

  .enterprise-story__network-grid {
    position: absolute;
    inset: 0;
    opacity: 0.42;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.18) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: radial-gradient(circle at center, #000, transparent 85%);
  }

  .enterprise-story__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .enterprise-story__links path {
    fill: none;
    stroke: rgba(37, 99, 235, 0.38);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .enterprise-story__provider {
    position: absolute;
    top: var(--provider-y);
    left: var(--provider-x);
    z-index: 3;
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 0.55rem;
    min-width: 6.8rem;
    padding: 0.58rem 0.68rem;
    border: 1px solid rgba(255, 255, 255, 0.88);
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
    transform: translate(-50%, -50%);
    backdrop-filter: blur(12px);
  }

  .enterprise-story__provider-logo {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    overflow: hidden;
    border-radius: 0.55rem;
    background: #f8fafc;
    color: #0f172a;
  }

  .enterprise-story__provider-logo img {
    display: block;
    width: 90%;
    height: 90%;
    object-fit: contain;
  }

  .enterprise-story__provider-logo :global(svg) {
    width: 1.45rem;
    height: 1.45rem;
  }

  .provider--equinix .enterprise-story__provider-logo {
    color: #ed1c24;
  }

  .provider--ourszone .enterprise-story__provider-logo {
    background: linear-gradient(145deg, #0f172a, #1d4ed8);
    color: #ffffff;
  }

  .enterprise-story__provider-monogram {
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: -0.08em;
  }

  .provider--lumen .enterprise-story__provider-logo {
    background: #111111;
    color: #ffffff;
  }

  .provider--hytron .enterprise-story__provider-logo {
    background: #0f172a;
  }

  .provider--hytron .enterprise-story__provider-logo img {
    filter: brightness(0) invert(1);
  }

  .provider--iij .enterprise-story__provider-logo img {
    width: 100%;
    height: auto;
  }

  .enterprise-story__provider > span {
    overflow: hidden;
    color: #0f172a;
    font-size: 0.65rem;
    font-weight: 800;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .enterprise-story__provider small {
    color: #94a3b8;
    font-size: 0.48rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .enterprise-story__provider--hub {
    z-index: 4;
    min-width: 9rem;
    padding: 0.75rem;
    border-color: rgba(37, 99, 235, 0.28);
    background: rgba(255, 255, 255, 0.96);
    box-shadow:
      0 0 0 0.55rem rgba(37, 99, 235, 0.07),
      0 18px 38px rgba(37, 99, 235, 0.2);
  }

  .enterprise-story__provider--hub > span {
    font-size: 0.72rem;
  }

  .enterprise-story__photo,
  .enterprise-story__ops-main {
