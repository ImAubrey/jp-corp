---
export interface Props {
  locale: string;
  t: (key: string) => string;
}

const { locale, t } = Astro.props;

function createLocalePath(path: string) {
  if (locale === "en") return path;
  return `/${locale}${path}`;
}

const metrics = [
  {
    value: 4,
    decimals: 0,
    suffix: "",
    label: t("home.motion.metrics.sites"),
  },
  {
    value: 24,
    decimals: 0,
    suffix: "/7",
    label: t("home.motion.metrics.operations"),
  },
  {
    value: 99.9,
    decimals: 1,
    suffix: "%",
    label: t("home.motion.metrics.uptime"),
  },
  {
    value: 2,
    decimals: 0,
    suffix: "",
    label: t("home.motion.metrics.regions"),
  },
];

const steps = [
  {
    number: "01",
    title: t("home.motion.steps.connect.title"),
    description: t("home.motion.steps.connect.description"),
  },
  {
    number: "02",
    title: t("home.motion.steps.route.title"),
    description: t("home.motion.steps.route.description"),
  },
  {
    number: "03",
    title: t("home.motion.steps.protect.title"),
    description: t("home.motion.steps.protect.description"),
  },
  {
    number: "04",
    title: t("home.motion.steps.deliver.title"),
    description: t("home.motion.steps.deliver.description"),
  },
];
---

<section
  id="network-flow"
  class="home-network-flow mt-24"
  data-home-network
  data-motion="none"
>
  <div class="home-network-flow__pin" data-home-network-pin>
    <div class="home-network-flow__heading">
      <div class="max-w-3xl">
        <p class="home-network-flow__kicker" data-home-network-copy>
          <span class="home-network-flow__kicker-dot"></span>
          {t("home.motion.kicker")}
        </p>
        <h2
          class="mt-4 text-4xl font-bold tracking-tight text-slate-950 md:text-5xl lg:text-6xl"
          data-home-network-copy
        >
          {t("home.motion.title")}
        </h2>
        <p
          class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600"
          data-home-network-copy
        >
          {t("home.motion.description")}
        </p>
      </div>

      <a
        href={createLocalePath("/data-centers/")}
        class="home-network-flow__status"
        data-home-network-copy
        data-motion="button"
      >
        <span class="home-network-flow__status-light"></span>
        <span>
          <strong>{t("home.motion.status")}</strong>
          <small>{t("home.motion.statusDetail")}</small>
        </span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="home-network-flow__stage" data-home-network-stage>
      <div class="home-network-flow__grid" aria-hidden="true"></div>
      <div class="home-network-flow__stage-label" data-home-network-card>
        <span>{t("home.motion.routeLabel")}</span>
        <strong>TY8 → TY1 → HK2 → HK COLO</strong>
      </div>

      <svg
        class="home-network-flow__map"
        viewBox="0 0 1000 360"
        role="img"
        aria-labelledby="home-network-map-title home-network-map-description"
      >
        <title id="home-network-map-title">{t("home.motion.mapTitle")}</title>
        <desc id="home-network-map-description">{t("home.motion.mapDescription")}</desc>
        <defs>
          <linearGradient id="home-route-gradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#38bdf8"></stop>
            <stop offset="48%" stop-color="#2563eb"></stop>
            <stop offset="100%" stop-color="#34d399"></stop>
          </linearGradient>
          <filter id="home-packet-glow" x="-200%" y="-200%" width="400%" height="400%">
            <feGaussianBlur stdDeviation="8" result="blur"></feGaussianBlur>
            <feMerge>
              <feMergeNode in="blur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
        </defs>

        <path
          class="home-network-flow__route-base"
          d="M90 235 C180 235 235 95 365 112 S545 280 650 218 S785 74 905 110"
        ></path>
        <path
          class="home-network-flow__route"
          data-home-route
          d="M90 235 C180 235 235 95 365 112 S545 280 650 218 S785 74 905 110"
        ></path>

        <g class="home-network-flow__node" data-home-node transform="translate(90 235)">
          <circle class="home-network-flow__node-ring" r="30"></circle>
          <circle class="home-network-flow__node-core" r="11"></circle>
          <text x="0" y="58" text-anchor="middle">TY8</text>
          <text class="home-network-flow__node-city" x="0" y="78" text-anchor="middle">TOKYO</text>
        </g>
        <g class="home-network-flow__node" data-home-node transform="translate(365 112)">
          <circle class="home-network-flow__node-ring" r="30"></circle>
          <circle class="home-network-flow__node-core" r="11"></circle>
          <text x="0" y="-49" text-anchor="middle">TY1</text>
          <text class="home-network-flow__node-city" x="0" y="-29" text-anchor="middle">TOKYO</text>
        </g>
        <g class="home-network-flow__node" data-home-node transform="translate(650 218)">
          <circle class="home-network-flow__node-ring" r="30"></circle>
          <circle class="home-network-flow__node-core" r="11"></circle>
          <text x="0" y="58" text-anchor="middle">HK2</text>
          <text class="home-network-flow__node-city" x="0" y="78" text-anchor="middle">HONG KONG</text>
        </g>
        <g class="home-network-flow__node" data-home-node transform="translate(905 110)">
          <circle class="home-network-flow__node-ring" r="30"></circle>
          <circle class="home-network-flow__node-core" r="11"></circle>
          <text x="0" y="-49" text-anchor="middle">HK COLO</text>
          <text class="home-network-flow__node-city" x="0" y="-29" text-anchor="middle">HONG KONG</text>
        </g>

        <circle
          class="home-network-flow__packet"
          data-home-packet
          r="8"
          cx="0"
          cy="0"
          filter="url(#home-packet-glow)"
        ></circle>
      </svg>

      <div class="home-network-flow__legend" data-home-network-card>
        <span><i class="home-network-flow__legend-dot"></i>{t("home.motion.legend.live")}</span>
        <span><i class="home-network-flow__legend-line"></i>{t("home.motion.legend.route")}</span>
        <strong>{t("home.motion.legend.secured")}</strong>
      </div>
    </div>
  </div>

  <div class="home-network-flow__metrics" data-home-network-metrics>
    {
      metrics.map((metric) => (
        <div class="home-network-flow__metric" data-home-network-metric>
          <strong>
            <span
              data-home-counter
              data-value={metric.value}
              data-decimals={metric.decimals}
            >
              {metric.value.toFixed(metric.decimals)}
            </span>
            <span>{metric.suffix}</span>
          </strong>
          <p>{metric.label}</p>
        </div>
      ))
    }
  </div>

  <div class="home-network-flow__steps" data-home-network-steps>
    {
      steps.map((step) => (
        <div class="home-network-flow__step" data-home-network-step>
          <span>{step.number}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .home-network-flow {
    position: relative;
    isolation: isolate;
  }

  .home-network-flow__pin {
    width: 100%;
    z-index: 2;
  }

  .home-network-flow__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .home-network-flow__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #475569;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .home-network-flow__kicker-dot,
  .home-network-flow__status-light {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.12);
  }

  .home-network-flow__status {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.85rem;
    min-width: 15rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(148, 163, 184, 0.34);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.7);
    color: #0f172a;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(16px);
  }

  .home-network-flow__status > span:nth-child(2) {
    display: grid;
    flex: 1;
    gap: 0.1rem;
  }

  .home-network-flow__status strong {
    font-size: 0.85rem;
  }

  .home-network-flow__status small {
    color: #64748b;
    font-size: 0.72rem;
  }

  .home-network-flow__stage {
    position: relative;
    min-height: 31rem;
    margin-top: 3rem;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 20% 12%, rgba(56, 189, 248, 0.14), transparent 30%),
      radial-gradient(circle at 86% 78%, rgba(52, 211, 153, 0.13), transparent 28%),
      linear-gradient(145deg, #07111f 0%, #0f172a 48%, #111c31 100%);
    box-shadow: 0 34px 85px rgba(15, 23, 42, 0.22);
  }

  .home-network-flow__grid {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.24) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.24) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }

  .home-network-flow__stage-label,
  .home-network-flow__legend {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(15, 23, 42, 0.72);
    color: #cbd5e1;
    backdrop-filter: blur(14px);
  }

  .home-network-flow__stage-label {
    top: 1.25rem;
    left: 1.25rem;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.8rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .home-network-flow__stage-label span {
    color: #64748b;
    text-transform: uppercase;
  }

  .home-network-flow__stage-label strong {
    color: #e2e8f0;
    font-weight: 600;
  }

  .home-network-flow__map {
    position: absolute;
    inset: 4.3rem 1rem 2.6rem;
    width: calc(100% - 2rem);
    height: calc(100% - 6.9rem);
    overflow: visible;
  }

  .home-network-flow__route-base,
  .home-network-flow__route {
    fill: none;
    stroke-linecap: round;
  }

  .home-network-flow__route-base {
    stroke: rgba(148, 163, 184, 0.16);
    stroke-width: 10;
  }

  .home-network-flow__route {
    stroke: url("#home-route-gradient");
    stroke-width: 4;
  }

  .home-network-flow__node-ring {
    fill: rgba(15, 23, 42, 0.86);
    stroke: rgba(125, 211, 252, 0.42);
    stroke-width: 2;
  }

  .home-network-flow__node-core {
    fill: #f8fafc;
    stroke: #38bdf8;
    stroke-width: 5;
  }

  .home-network-flow__node text {
    fill: #f8fafc;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .home-network-flow__node .home-network-flow__node-city {
    fill: #64748b;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .home-network-flow__packet {
    fill: #ffffff;
    stroke: #38bdf8;
    stroke-width: 5;
    opacity: 0;
  }

  .home-network-flow__legend {
    right: 1.25rem;
    bottom: 1.25rem;
    gap: 1rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.8rem;
    font-size: 0.68rem;
  }

  .home-network-flow__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .home-network-flow__legend strong {
    padding-left: 0.9rem;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    color: #86efac;
    font-weight: 600;
  }

  .home-network-flow__legend-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #34d399;
  }

  .home-network-flow__legend-line {
    width: 1.1rem;
    height: 2px;
    background: linear-gradient(90deg, #38bdf8, #34d399);
  }

  .home-network-flow__metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .home-network-flow__metric {
    padding: 1.4rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(16px);
  }

  .home-network-flow__metric strong {
    display: inline-flex;
    align-items: baseline;
    color: #0f172a;
    font-size: clamp(1.8rem, 3vw, 2.65rem);
    letter-spacing: -0.04em;
  }

  .home-network-flow__metric p {
    margin-top: 0.3rem;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .home-network-flow__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .home-network-flow__step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .home-network-flow__step > span {
    color: #94a3b8;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .home-network-flow__step h3 {
    color: #0f172a;
    font-size: 1rem;
    font-weight: 700;
  }

  .home-network-flow__step p {
    margin-top: 0.4rem;
    color: #64748b;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .home-network-flow__heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-network-flow__stage {
      min-height: 27rem;
    }

    .home-network-flow__metrics,
    .home-network-flow__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .home-network-flow__status {
      width: 100%;
      min-width: 0;
    }

    .home-network-flow__stage {
      min-height: 23rem;
      border-radius: 1.4rem;
    }

    .home-network-flow__stage-label {
      right: 1rem;
      left: 1rem;
      justify-content: space-between;
    }

    .home-network-flow__stage-label strong {
      max-width: 62%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-network-flow__map {
      inset: 4rem 0.25rem 2.5rem;
      width: calc(100% - 0.5rem);
      height: calc(100% - 6.5rem);
    }

    .home-network-flow__legend {
      right: 0.8rem;
      bottom: 0.8rem;
      left: 0.8rem;
      justify-content: space-between;
    }

    .home-network-flow__legend strong {
      display: none;
    }

    .home-network-flow__metrics {
      gap: 0.7rem;
    }

    .home-network-flow__metric {
      padding: 1rem;
    }

    .home-network-flow__steps {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-network-flow [data-home-network-copy],
    .home-network-flow [data-home-network-card],
    .home-network-flow [data-home-node],
    .home-network-flow [data-home-packet],
    .home-network-flow [data-home-network-metric],
    .home-network-flow [data-home-network-step] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }

    .home-network-flow [data-home-packet] {
      opacity: 0 !important;
    }
  }
</style>
